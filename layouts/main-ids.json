{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "ids-workspace-chrome"
          },
          "size": {
            "px": 46
          },
          "window_drag": true,
          "children": []
        },
        {
          "id": "sidebar-lists",
          "type": "stack",
          "children": [
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "ids-agents"
              },
              "title": "Agents",
              "children": []
            },
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "ids-spaces"
              },
              "title": "Spaces",
              "children": []
            }
          ],
          "active": "agents",
          "header": {
            "content": {
              "mod": "ids-sidebar",
              "props": {
                "stack": "sidebar-lists"
              }
            },
            "height": 34
          }
        }
      ],
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "content": {
            "mod": "ids-tabs"
          },
          "size": {
            "px": 42
          },
          "window_drag": true,
          "children": []
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "ids-pane"
                    },
                    "reveal": "always",
                    "height": 30,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 1,
                    "color": "border"
                  },
                  "focus": {
                    "width": 1,
                    "color": "accent"
                  },
                  "radius": 10,
                  "gap": 8,
                  "lone": true
                }
              },
              "children": []
            },
            {
              "id": "panel",
              "type": "column",
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "size": {
                    "weight": 1
                  },
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "ids-files"
                      },
                      "title": "Files",
                      "children": []
                    },
                    {
                      "id": "chief",
                      "type": "column",
                      "children": [
                        {
                          "id": "chief-session",
                          "type": "block",
                          "content": {
                            "terminal": "chief-staff"
                          }
                        }
                      ],
                      "title": "Chief of Staff",
                      "padding": 0
                    }
                  ],
                  "active": "chief",
                  "header": {
                    "content": {
                      "mod": "ids-panel",
                      "props": {
                        "stack": "panel-body"
                      }
                    },
                    "height": 34
                  }
                }
              ]
            }
          ],
          "padding": 8,
          "gap": 8
        },
        {
          "id": "chief-note",
          "type": "block",
          "size": {
            "px": 0
          },
          "max": 0,
          "content": {
            "mod": "chief-of-staff"
          }
        },
        {
          "id": "status",
          "type": "block",
          "content": {
            "mod": "workspace-status"
          },
          "size": {
            "px": 28
          },
          "children": []
        }
      ],
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "terminal_menu": "ids-menu"
}
