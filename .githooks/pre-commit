#!/usr/bin/env sh
# Deployment belongs after the commit. Native mod validation is a local gate.
set -eu
root=$(git rev-parse --show-toplevel)
python3 - "$root" <<'PYCODE'
import json, pathlib, sys
for path in (pathlib.Path(sys.argv[1]) / 'layouts').glob('*.json'):
    json.loads(path.read_text())
PYCODE
